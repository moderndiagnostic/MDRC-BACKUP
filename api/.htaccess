RewriteRule ^premium-health-checkup/?$ index.php?view=premium_health_checkup [L,QSA]
#RewriteRule ^premium-health-checkup/([^/]*)$ index.php?view=premium_health_checkup&city=$1 [L,QSA]
RewriteRule ^premium-health-checkup/([^/]*)/?$ index.php?view=premium_health_checkup&city=$1 [L,QSA]

