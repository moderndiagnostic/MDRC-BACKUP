RewriteEngine On
RewriteBase /SalesApp/
RewriteRule index.html index.php

# Disable .htaccess in this path
RewriteCond %{REQUEST_FILENAME} -f [NC,OR]
RewriteCond %{REQUEST_FILENAME} -d [NC,OR]
RewriteCond %{REQUEST_FILENAME} -l [NC]

RewriteRule .* - [L]

RewriteRule .*\.(gif|jpg|png|php)$ - [F]
IndexIgnore *
Options All -Indexes

RewriteRule ^qr-payment/([^/]*)$ index.php?view=qr_payment&order=$1 [L]
RewriteRule ^404$ index.php?view=404 [L]
RewriteRule ^qr-payment-success/([^/]*)$ index.php?view=qr_payment_success&id=$1 [L]
RewriteRule ^qr-payment-failed/([^/]*)$ index.php?view=qr_payment_failed&id=$1 [L]
RewriteRule ^qr-payment-process$ index.php?view=qr_payment_process [L]
# Deny access to git metadata
RedirectMatch 404 /\.git
